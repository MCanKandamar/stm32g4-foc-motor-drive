{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "type": "stlinkgdbtarget",
            "request": "launch",
            "name": "STM32Cube: Launch ST-Link GDB Server",
            "origin": "snippet",
            "cwd": "${workspaceFolder}",
            "preBuild": "${command:st-stm32-ide-debug-launch.build}",
            "runEntry": "main",
            "imagesAndSymbols": [
                {
                    // copy with the Scrutiny firmware ID inside (made by scrutiny_postbuild after the build)
                    //"imageFileName": "${workspaceFolder}/build/Debug/015_BLDC_FOC_RTOS_MotorDrive_tagged.elf"
                    "imageFileName": "${workspaceFolder}/build/Release/015_bldc_foc_rtos_motordrive_tagged.elf"
                }
            ],
            "liveWatch": {
                "enabled": true,
                "samplesPerSecond": "10"
            }
        }
    ]
}
