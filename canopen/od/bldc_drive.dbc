CM_ SG_ 397 VelocityActual "0x606C";
CM_ SG_ 653 TorqueActual "0x6077";
CM_ SG_ 653 ModeDisplay "0x6061";
CM_ SG_ 141 ErrorCode "0x603F / CiA 402 error code";

VAL_ 653 ModeDisplay 3 "Profile velocity" 4 "Profile torque" ;
VAL_ 1805 NMTState 0 "Boot-up" 4 "Stopped" 5 "Operational" 127 "Pre-operational" ;
